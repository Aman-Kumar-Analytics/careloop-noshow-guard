nsform(X_train)     # sirf train pe fit\n","X_test_s = scaler.transform(X_test)\n","\n","model = LogisticRegression(max_iter=1000)\n","model.fit(X_train_s, y_train)\n","\n","pred = model.predict(X_test_s)\n","prob = model.predict_proba(X_test_s)[:, 1]\n","\n","print(\"accuracy :\", round(accuracy_score(y_test, pred), 3))\n","print(\"confusion matrix:\\n\", confusion_matrix(y_test, pred))\n","print(\"precision:\", round(precision_score(y_test, pred), 2))\n","print(\"recall   :\", round(recall_score(y_test, pred), 2))\n","print(\"F1       :\", round(f1_score(y_test, pred), 2))\n","print(\"ROC-AUC  :\", round(roc_auc_score(y_test, prob), 3))\n","\n","coefs = pd.Series(model.coef_[0], index=X.columns)\n","print(coefs.round(2))\n","\n","i = list(X.columns).index(\"reminder_sent\")\n","print(\"exp(coef) scaled        :\", round(np.exp(model.coef_[0][i]), 2))\n","print(\"exp(coef / scale) real  :\", round(np.exp(model.coef_[0][i] / scaler.scale_[i]), 2))\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ncQl7oCmY2h5","executionInfo":{"status":"ok","timestamp":1795353180693,"user_tz":-330,"elapsed":1325,"user":{"displayName":"Aman Kumar","userId":"04381106124568341984"}},"outputId":"b36a75a8-18ca-4242-da63-1bcb726a5de6"},"execution_count":12,"outputs":[{"output_type":"stream","name":"stdout","text":["accuracy : 0.788\n","confusion matrix:\n"," [[139  10]\n"," [ 32  17]]\n","precision: 0.63\n","recall   : 0.35\n","F1       : 0.45\n","ROC-AUC  : 0.789\n","age                       -0.25\n","distance_km                0.25\n","fee_inr                    0.45\n","lead_days                  0.61\n","prior_no_shows             0.65\n","reminder_sent             -0.58\n","booking_channel_App       -0.05\n","booking_channel_Phone      0.22\n","booking_channel_Walk-In   -0.19\n","visit_type_Consultation    0.02\n","visit_type_Follow-up      -0.02\n","dtype: float64\n","exp(coef) scaled        : 0.56\n","exp(coef / scale) real  : 0.31\n"]}]},{"cell_type":"code","source":["from sklearn.tree import DecisionTreeClassifier\n","from sklearn.ensemble import RandomForestClassifier\n","\n","# 3.3 Decision tree: bina limit aur depth 3\n","tree_full = DecisionTreeClassifier(random_state=42).fit(X_train, y_train)\n","tree_3 = DecisionTreeClassifier(max_depth=3, random_state=42).fit(X_train, y_train)\n","\n","for name, t in [(\"full tree\", tree_full), (\"depth-3 tree\", tree_3)]:\n","    print(name, \"| train:\", round(t.score(X_train, y_train), 3),\n","          \"| test:\", round(t.score(X_test, y_test), 3))\n","print(\"full tree depth:\", tree_full.get_depth())\n","\n","# 3.4 Random forest\n","rf = RandomForestClassifier(n_estimators=100, random_state=42).fit(X_train, y_train)\n","rf_pred = rf.predict(X_test)\n","rf_prob = rf.predict_proba(X_test)[:, 1]\n","print(\"RF accuracy:\", round(accuracy_score(y_test, rf_pred), 3),\n","      \"| recall:\", round(recall_score(y_test, rf_pred), 2),\n","      \"| AUC:\", round(roc_auc_score(y_test, rf_prob), 3))\n","print(pd.Series(rf.feature_importances_, index=X.columns).sort_values(ascending=False).head(3).round(2))\n","\n","# comparison table\n","t3_prob = tree_3.predict_proba(X_test)[:, 1]\n","table = pd.DataFrame({\n","    \"accuracy\": [accuracy_score(y_test, pred), tree_3.score(X_test, y_test), accuracy_score(y_test, rf_pred)],\n","    \"recall\":   [recall_score(y_test, pred), recall_score(y_test, tree_3.predict(X_test)), recall_score(y_test, rf_pred)],\n","    \"ROC-AUC\":  [roc_auc_score(y_test, prob), roc_auc_score(y_test, t3_prob), roc_auc_score(y_test, rf_prob)],\n","}, index=[\"Logistic regression\", \"Depth-3 tree\", \"Random forest\"]).round(3)\n","print(table)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"EfG3nQ7BZGaW","executionInfo":{"status":"ok","timestamp":1795353250187,"user_tz":-330,"elapsed":4239,"user":{"displayName":"Aman Kumar","userId":"04381106124568341984"}},"outputId":"ff010cc5-2af3-4ae0-d547-4bd93b1768cf"},"execution_count":14,"outputs":[{"output_type":"stream","name":"stdout","text":["full tree | train: 1.0 | test: 0.672\n","depth-3 tree | train: 0.822 | test: 0.778\n","full tree depth: 15\n","RF accuracy: 0.747 | recall: 0.31 | AUC: 0.706\n","lead_days      0.22\n","age            0.20\n","distance_km    0.19\n","dtype: float64\n","                     accuracy  recall  ROC-AUC\n","Logistic regression     0.788   0.347    0.789\n","Depth-3 tree            0.778   0.224    0.700\n","Random forest           0.747   0.306    0.706\n"]}]},{"cell_type":"code","source":["from sklearn.pipeline import Pipeline\n","from sklearn.model_selection import GridSearchCV, cross_val_score, cross_val_predict\n","\n","# (a) Random forest tuning, sirf train pe\n","grid = GridSearchCV(RandomForestClassifier(random_state=42),\n","                    {\"n_estimators\": [100, 200], \"max_depth\": [3, 5, 8]},\n","                    cv=5, scoring=\"roc_auc\")\n","grid.fit(X_train, y_train)\n","print(\"best_params_:\", grid.best_params_, \"| best_score_:\", round(grid.best_score_, 3))\n","\n","# (b) Model ka chunav: train pe 5-fold CV AUC\n","lr_pipe = Pipeline([(\"scaler\", StandardScaler()), (\"model\", LogisticRegression(max_iter=1000))])\n","candidates = {\n","    \"Logistic regression\": lr_pipe,\n","    \"Depth-3 tree\": DecisionTreeClassifier(max_depth=3, random_state=42),\n","    \"Random forest\": RandomForestClassifier(n_estimators=100, random_state=42),\n","}\n","cv_auc = {n: cross_val_score(m, X_train, y_train, cv=5, scoring=\"roc_auc\").mean()\n","          for n, m in candidates.items()}\n","cv_auc[\"Tuned forest\"] = grid.best_score_\n","print({k: round(v, 3) for k, v in cv_auc.items()})\n","winner_name = max(cv_auc, key=cv_auc.get)\n","print(\"winner:\", winner_name)\n","winner = grid.best_estimator_ if winner_name == \"Tuned forest\" else candidates[winner_name]\n","\n","# (c) Threshold ka chunav: out-of-fold train probabilities\n","oof = cross_val_predict(winner, X_train, y_train, cv=5, method=\"predict_proba\")[:, 1]\n","res = {}\n","for t in (0.5, 0.35):\n","    f = (oof >= t).astype(int)\n","    res[t] = f1_score(y_train, f)\n","    print(f\"threshold {t}: precision {precision_score(y_train, f):.2f} | recall {recall_score(y_train, f):.2f} \"\n","          f\"| F1 {res[t]:.2f} | flagged {f.sum()}\")\n","THR = 0.35 if res[0.35] > res[0.5] else 0.5\n","print(\"chosen threshold:\", THR)\n","\n","# (d) Test pe sirf ek baar\n","winner.fit(X_train, y_train)\n","probs = winner.predict_proba(X_test)[:, 1]\n","flag = (probs >= THR).astype(int)\n","print(\"TEST | precision:\", round(precision_score(y_test, flag), 2), \"| recall:\", round(recall_score(y_test, flag), 2),\n","      \"| flagged:\", flag.sum(), \"| ROC-AUC:\", round(roc_auc_score(y_test, probs), 3))\n","\n","# (e) test_risk_scores.csv\n","out = pd.DataFrame({\"appointment_id\": ids.loc[X_test.index].values, \"no_show\": y_test.values,\n","                    \"risk_prob\": probs.round(4), \"flag\": flag})\n","out.to_csv(\"test_risk_scores.csv\", index=False)\n","print(out.shape, \"| flag=1:\", out[\"flag\"].sum())\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"YoKvLDOiZRVR","executionInfo":{"status":"ok","timestamp":1795353318803,"user_tz":-330,"elapsed":27347,"user":{"displayName":"Aman Kumar","userId":"04381106124568341984"}},"outputId":"7ef2305b-7c71-4276-d690-45f6c080c010"},"execution_count":15,"outputs":[{"output_type":"stream","name":"stdout","text":["best_params_: {'max_depth': 3, 'n_estimators': 200} | best_score_: 0.767\n","{'Logistic regression': np.float64(0.774), 'Depth-3 tree': np.float64(0.678), 'Random forest': np.float64(0.747), 'Tuned forest': np.float64(0.767)}\n","winner: Logistic regression\n","threshold 0.5: precision 0.58 | recall 0.25 | F1 0.35 | flagged 73\n","threshold 0.35: precision 0.51 | recall 0.47 | F1 0.49 | flagged 154\n","chosen threshold: 0.35\n","TEST | precision: 0.57 | recall: 0.57 | flagged: 49 | ROC-AUC: 0.789\n","(198, 4) | flag=1: 49\n"]}]}]}